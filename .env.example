# GoFlow Workflow Engine - Environment Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Application Configuration
# ============================================================================

# Application name
APP_NAME=goflow-workflow-engine

# Environment: development, staging, production
APP_ENV=development

# Application version
APP_VERSION=1.0.0

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============================================================================
# HTTP Server Configuration
# ============================================================================

# Server port
PORT=8080

# Server host (0.0.0.0 for all interfaces, localhost for local only)
HOST=0.0.0.0

# Gin mode: debug, release, test
GIN_MODE=debug

# Server timeouts (in seconds)
READ_TIMEOUT=15
WRITE_TIMEOUT=15
IDLE_TIMEOUT=60
SHUTDOWN_TIMEOUT=30

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================

# Database host
DB_HOST=localhost

# Database port
DB_PORT=5432

# Database name
DB_NAME=goflow_db

# Database user
DB_USER=goflow_user

# Database password
DB_PASSWORD=goflow_password

# Database SSL mode: disable, require, verify-ca, verify-full
DB_SSL_MODE=disable

# Maximum number of open connections
DB_MAX_OPEN_CONNS=25

# Maximum number of idle connections
DB_MAX_IDLE_CONNS=5

# Maximum connection lifetime (in minutes)
DB_MAX_CONN_LIFETIME=5

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# Redis connection pool size
REDIS_POOL_SIZE=10

# Redis connection timeout (in seconds)
REDIS_TIMEOUT=5

# ============================================================================
# Kafka Configuration
# ============================================================================

# Kafka brokers (comma-separated list)
KAFKA_BROKERS=localhost:9092

# Kafka consumer group ID
KAFKA_GROUP_ID=goflow-consumer-group

# Kafka topic for workflow events
KAFKA_WORKFLOW_TOPIC=workflow-events

# Kafka topic for execution events
KAFKA_EXECUTION_TOPIC=execution-events

# Kafka session timeout (in seconds)
KAFKA_SESSION_TIMEOUT=10

# Kafka heartbeat interval (in seconds)
KAFKA_HEARTBEAT_INTERVAL=3

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT secret key (use a strong random string in production)
JWT_SECRET=your-secret-key-change-this-in-production

# JWT token expiration (in hours)
JWT_EXPIRATION=24

# API rate limit (requests per minute)
RATE_LIMIT=1000

# Enable CORS
CORS_ENABLED=true

# CORS allowed origins (comma-separated list, * for all)
CORS_ALLOWED_ORIGINS=*

# ============================================================================
# External Services
# ============================================================================

# OpenAI API key (for AI-powered features)
OPENAI_API_KEY=

# OpenAI model
OPENAI_MODEL=gpt-4

# Webhook base URL (for webhook callbacks)
WEBHOOK_BASE_URL=http://localhost:8080

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Enable metrics endpoint
METRICS_ENABLED=true

# Metrics port
METRICS_PORT=9090

# Enable tracing
TRACING_ENABLED=false

# Jaeger endpoint (for distributed tracing)
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# Workflow Engine Configuration
# ============================================================================

# Maximum concurrent workflow executions
MAX_CONCURRENT_EXECUTIONS=100

# Default workflow timeout (in minutes)
DEFAULT_WORKFLOW_TIMEOUT=30

# Maximum workflow execution retries
MAX_EXECUTION_RETRIES=3

# Worker pool size
WORKER_POOL_SIZE=10

# Task queue size
TASK_QUEUE_SIZE=1000

# ============================================================================
# Feature Flags
# ============================================================================

# Enable async execution
FEATURE_ASYNC_EXECUTION=true

# Enable workflow scheduling
FEATURE_SCHEDULING=true

# Enable webhooks
FEATURE_WEBHOOKS=true

# Enable AI integration
FEATURE_AI_INTEGRATION=false
